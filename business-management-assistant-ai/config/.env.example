# sandbox | staging | production. Anything but sandbox requires API_KEYS.
ENVIRONMENT=sandbox
DATABASE_URL=sqlite:///./business_assistant.db
MODEL_POLICY=provider-neutral
# Sandbox creates tables automatically. Elsewhere run `alembic upgrade head` (the Docker image does this on start).
# AUTO_CREATE_SCHEMA=false

# name:role:secret, comma separated. Roles: viewer, operator, admin. Secrets must be 24+ characters outside sandbox.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=

# Defaults: false in sandbox, true elsewhere. Stops a human approving the request they raised.
# REQUIRE_DISTINCT_REVIEWER=true
APPROVAL_TTL_HOURS=72
HIGH_VALUE_THRESHOLD=1000
RATE_LIMIT_PER_MINUTE=240

# ---- Models: nothing needs choosing. Every reachable model is discovered and used (docs/models.md).
# Discovery uses provider keys found in the environment (ANTHROPIC_API_KEY, OPENAI_API_KEY, OPENROUTER_API_KEY, GROQ_API_KEY,
# TOGETHER_API_KEY, MISTRAL_API_KEY) and well-known local servers (Ollama 11434, LM Studio 1234, llama.cpp 8080, 8001).
LLM_AUTO_DISCOVER=true
# quality | local | hosted: tie-break between tiers. LLM_ALLOW_HOSTED=false keeps business data on private endpoints.
LLM_PREFER=quality
LLM_ALLOW_HOSTED=true
LLM_MAX_CASCADE=3
LLM_REFRESH_SECONDS=300
# Written by scripts/evaluate_models.py; models scoring below LLM_MIN_PLAN_SCORE stop being used for planning.
LLM_SCORES_PATH=data/evaluation/scores.json
LLM_MIN_PLAN_SCORE=0.5
# Extra endpoints (JSON). "model"/"models" pin; omit to discover. api_key_env names a variable holding the secret.
# LLM_ENDPOINTS=[{"name":"vllm","base_url":"http://10.0.0.5:8000","priority":50},{"name":"claude","provider":"anthropic","api_key_env":"ANTHROPIC_API_KEY","daily_limit":500}]
# Or pin a single model:
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://127.0.0.1:8001
# LLM_MODEL=Qwen/Qwen3-8B
# LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=800
LLM_DAILY_CALL_LIMIT=2000
# rules | hybrid | llm. Default: hybrid when any model is reachable, rules otherwise.
# ASSISTANT_MODE=hybrid

# ---- Connectors (used outside sandbox; sandbox always dry-runs). Staging requires SMTP_ALLOWED_DOMAINS.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_SENDER=assistant@example.com
# SMTP_SECURITY=starttls
# SMTP_ALLOWED_DOMAINS=example.com
# SLACK_WEBHOOK_URL=
# WEBHOOK_ROUTES=[{"name":"crm","prefix":"crm","url":"https://hooks.example.com/crm","secret":"at-least-16-characters"}]
# Operator notices when an approval is waiting (never include message bodies):
# NOTIFY_EMAIL=you@example.com
# NOTIFY_WEBHOOK_URL=

# Used by docker compose only.
# POSTGRES_PASSWORD=
# Add provider credentials only through your deployment secret manager.
